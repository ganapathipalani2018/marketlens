# Create an app at developers.kite.trade and keep these credentials private.
KITE_API_KEY=
KITE_API_SECRET=

# Register this exact redirect URL in your Kite developer app.
KITE_REDIRECT_URL=http://127.0.0.1:3000/auth/kite/callback
PORT=3000

# Public-filing research: none, ollama, openai, or auto (local then OpenAI).
# Generation is optional and requested explicitly in the interface.
RESEARCH_AI_PROVIDER=none
RESEARCH_OLLAMA_MODEL=
OPENAI_MODEL=
OPENAI_API_KEY=
